{
  "name": "screenscribe-v2",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:ui": "node scripts/verify-prototype.mjs",
    "dev:web": "vite --host 127.0.0.1 --strictPort",
    "dev:server": "node scripts/dev-server.mjs",
    "serve": "tsx --tsconfig tsconfig.server.json server/index.ts",
    "test": "vitest run",
    "format": "prettier --write src server shared scripts *.ts *.json index.html",
    "format:check": "prettier --check src server shared scripts *.ts *.json index.html",
    "test:app": "node scripts/verify-application.mjs",
    "test:extended": "node scripts/verify-extended.mjs",
    "test:parity": "node scripts/verify-parity.mjs",
    "open": "tsx --tsconfig tsconfig.server.json scripts/open-local.ts",
    "open:dev": "npm run open -- --dev",
    "test:auth": "node --import tsx scripts/verify-local-auth.mjs",
    "test:dev-watch": "node --test scripts/dev-server.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/instrument-serif": "5.3.0",
    "@google/genai": "2.29.1",
    "@xyflow/react": "12.12.0",
    "express": "5.3.0",
    "image-size": "2.0.4",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.57.0",
    "marked": "18.1.1",
    "mermaid": "12.2.0",
    "multer": "2.4.0",
    "nanoid": "6.0.2",
    "open": "11.0.4",
    "openai": "7.33.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
