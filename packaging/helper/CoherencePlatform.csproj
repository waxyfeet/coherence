<Project Sdk="Microsoft.NET.Sdk">
  <!-- CoherencePlatform.exe, the native platform helper (installer report §8, Stage 6). It replaces every runtime use of
       PowerShell: storage guard, Known Folders, DPAPI, folder permissions, folder chooser and "Open project folder".
       .NET Framework 4.8 is part of Windows 10/11. Built with the launcher by packaging/build-launcher.mjs. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CoherencePlatform</AssemblyName>
    <RootNamespace>Coherence.Platform</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=helper</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Product>Coherence</Product>
    <Company>Deon Fouche</Company>
    <Copyright>Copyright (c) Deon Fouche. MIT licence.</Copyright>
    <!-- Set by packaging/build-launcher.mjs from package.json. -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
