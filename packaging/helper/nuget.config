<?xml version="1.0" encoding="utf-8"?>
<!-- The helper needs one package family: Microsoft's .NET Framework 4.8 reference assemblies (build-time only; nothing
     ships). Source mapping refuses any other package; the lock file pins its content hash and
     packaging/build-launcher.mjs verifies its signature. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.NETFramework.ReferenceAssemblies" />
      <package pattern="Microsoft.NETFramework.ReferenceAssemblies.net48" />
    </packageSource>
  </packageSourceMapping>
</configuration>
