<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher needs exactly two package families: Microsoft's .NET Framework 4.8 reference assemblies (build-time
     only) and Microsoft's WebView2 SDK (the app window; BSD-3-Clause, ships with the app). Source mapping refuses any
     other package, so a restore can never pull in more; the lock files pin their content hashes and
     packaging/build-launcher.mjs verifies their signatures. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.NETFramework.ReferenceAssemblies" />
      <package pattern="Microsoft.NETFramework.ReferenceAssemblies.net48" />
      <package pattern="Microsoft.Web.WebView2" />
    </packageSource>
  </packageSourceMapping>
</configuration>
