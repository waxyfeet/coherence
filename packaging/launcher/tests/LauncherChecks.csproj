<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks for the launcher's pure logic, built against the same sources (no test framework to download).
       Run by packaging/build-launcher.mjs; exits non-zero on the first failed check. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefineConstants>$(DefineConstants);COHERENCE_TEST_BUILD</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Checks.cs" />
    <Compile Include="../src/AppPaths.cs" />
    <Compile Include="../src/Backend.cs" />
    <Compile Include="../src/BrowserLauncher.cs" />
    <Compile Include="../src/ExitCodes.cs" />
    <Compile Include="../src/LaunchOptions.cs" />
    <Compile Include="../src/LauncherState.cs" />
    <Compile Include="../src/Log.cs" />
    <Compile Include="../src/NativeMethods.cs" />
    <Compile Include="../src/Protocol.cs" />
    <Compile Include="../src/StartupMessages.cs" />
  </ItemGroup>
</Project>
