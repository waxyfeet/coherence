              "by": "settings",
              "label": "Your Jira settings plus Coherence's identity labels"
            },
            "ownership": "coherence"
          },
          {
            "fieldId": "customfield_10050",
            "fieldName": "Acceptance Criteria",
            "kind": "rich-text",
            "value": "#### SC-01 · Successful sign-in (happy path)\n\n```gherkin\nGIVEN the Login screen is displayed\nAND the user has an active account\nWHEN the user enters a registered email address in \"Email address\"\nAND the user selects \"Sign in\"\nTHEN the user is signed in\nTHEN the Dashboard screen is displayed\n```",
            "provenance": {
